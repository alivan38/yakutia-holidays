{
  "name": "yakutia-holidays",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "install:server": "npm install --prefix server --ignore-scripts",
    "dev:client": "vite",
    "dev:server": "node server/ensure-directus.mjs && node server/ensure-token.mjs && node server/server.js",
    "directus:up": "docker compose up -d directus",
    "server": "node server/ensure-token.mjs && node server/server.js",
    "client": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup:directus": "node server/setup-directus.mjs",
    "docker:setup-directus": "docker compose exec api /docker/run-setup-directus.sh",
    "docker:diagnose-images": "docker compose exec api /docker/run-diagnose-images.sh",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/multimonth": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@tanstack/react-query": "^5.80.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
