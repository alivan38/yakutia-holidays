# Скопируй этот файл в .env и заполни значения

# URL до Directus (без слэша в конце)
DIRECTUS_URL=http://localhost:8055

# Static Token из Directus:
# Настройки → Users → твой пользователь → Token → Generate
DIRECTUS_TOKEN=вставь_сюда_static_token

# URL фронтенда (для CORS)
CLIENT_URL=http://localhost:5173

# Порт Node.js сервера
PORT=5000
