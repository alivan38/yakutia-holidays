WEB_PORT=8081
API_PORT=5000
DIRECTUS_PORT=8058

DIRECTUS_URL=http://localhost:8058
PUBLIC_DIRECTUS_URL=http://localhost:8058
DIRECTUS_KEY=yakutia-random-key-change-me
DIRECTUS_SECRET=yakutia-super-secret-key-change-me
ADMIN_EMAIL=admin@yakutia.ru
ADMIN_PASSWORD=admin123
DIRECTUS_STATIC_TOKEN=yakutia-docker-api-token

PORT=5000
CLIENT_URL=http://localhost:8081,http://localhost:5173
CORS_ORIGIN=http://localhost:8081,http://localhost:5173,http://localhost

# Оставьте пустым в Docker — сайт и API на одном порту (WEB_PORT)
VITE_API_URL=
VITE_DIRECTUS_URL=http://localhost:8058

# Yandex SmartCaptcha — https://console.yandex.cloud/folders/<folder>/smartcaptcha
# Client key (ysc1_...) — во фронт; Server key (ysc2_...) — только в api
# В настройках капчи добавьте домены: localhost, ваш-сайт.ru
VITE_SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
# CAPTCHA_REQUIRED=true
# VITE_SMARTCAPTCHA_TEST=true
